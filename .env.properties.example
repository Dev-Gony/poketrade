# .env.properties.example → .env.properties 로 복사해 실제 값을 채운다. (.env.properties 는 Git 에 커밋하지 않는다)
# Neon 콘솔의 접속 문자열 postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require 를
# 아래처럼 JDBC 형식으로 나눠 적는다. (channel_binding → channelBinding)
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require&channelBinding=require
DB_USERNAME=<user>
DB_PASSWORD=<password>
