{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "poketrade-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "poketrade-web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "-p",
        "3005"
      ],
      "env": {
        "NEXT_DIST_DIR": ".next-preview"
      },
      "port": 3005
    },
    {
      "name": "poketrade-web-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "-p",
        "3006"
      ],
      "env": {
        "NEXT_DIST_DIR": ".next-demo",
        "BACKEND_URL": "http://localhost:9",
        "NEXT_PUBLIC_BACKEND_URL": "http://localhost:9"
      },
      "port": 3006
    }
  ]
}
